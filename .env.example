# ==============================================================================
# TeamProof Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
# 
# IMPORTANT: Never commit actual passwords or connection strings to version control.
# ==============================================================================

NODE_ENV=development
PORT=5001

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/teamproof?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@your-cluster.mongodb.net/teamproof?retryWrites=true&w=majority

# Dedicated Test Database URI
# Used exclusively by integration test runners to guarantee isolation from demo/production data.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/teamproof_test

# Client Frontend URL for CORS configuration
CLIENT_URL=http://localhost:5173

# Server Session Secret
SESSION_SECRET=teamproof-secure-academic-session-key-change-in-prod

# ==============================================================================
# GitHub App Integration Configuration
# ==============================================================================
# Created in GitHub -> Settings -> Developer Settings -> GitHub Apps -> New GitHub App
# 1. App Name: TeamProof (or TeamProof-YourName)
# 2. Homepage URL: http://localhost:5173
# 3. Callback URL: http://localhost:5001/api/v1/github/callback
# 4. Webhook URL: (Use ngrok or deployment URL, e.g. https://your-domain.com/api/v1/github/webhook)
# 5. Webhook Secret: Generate a secure random string and set below
# 6. Permissions:
#    - Repository permissions -> Contents: Read
#    - Repository permissions -> Issues: Read
#    - Repository permissions -> Pull requests: Read
#    - Repository permissions -> Metadata: Read-only
# 7. Subscribe to events: Push, Pull request, Issues
# ==============================================================================

# GitHub App ID (Numeric ID from GitHub App General Settings)
GITHUB_APP_ID=your_github_app_id

# GitHub App URL Slug (e.g., https://github.com/apps/<app-slug>)
GITHUB_APP_SLUG=your-teamproof-app-slug

# GitHub App Client ID & Secret (for optional user identification)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Webhook secret configured in GitHub App settings (used for HMAC SHA-256 verification)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_min_32_chars

# GitHub App Private Key (Download .pem from GitHub App General Settings)
# Can be pasted as multi-line string or base64-encoded string:
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# GitHub App Redirect / Callback URL
GITHUB_CALLBACK_URL=http://localhost:5001/api/v1/github/callback

