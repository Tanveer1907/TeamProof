# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.vite/

# Environment files - strictly ignore all actual secret files
.env
.env*.local
.env.development
.env.test
.env.production
apps/*/.env

# Explicitly ensure .env.example is tracked
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Uploads & Temp
apps/api/uploads/*
!apps/api/uploads/.gitkeep
backups/
/tmp/

# OS files
.DS_Store
Thumbs.db
